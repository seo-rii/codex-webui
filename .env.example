# Required. Use `pnpm hash-password` to generate the hash.
CODEX_WEBUI_PASSWORD_HASH=

# Optional runtime overrides.
# Plaintext password env vars are accepted only for loopback/local development.
# CODEX_WEBUI_PASSWORD=
# CODEX_WEBUI_SESSION_SECRET=
# CODEX_WEBUI_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
# CODEX_WEBUI_HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
# CODEX_WEBUI_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# CODEX_WEBUI_REQUIRE_ORIGIN_HEADER=false
# Optional allowlist for outbound notification webhooks. Supports exact hosts and *.example.com.
# CODEX_WEBUI_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,*.trusted.example.com
# CODEX_WEBUI_TRUST_PROXY_HEADERS=false
# CODEX_WEBUI_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# CODEX_WEBUI_COOKIE_SAMESITE=strict
# CODEX_WEBUI_COOKIE_SECURE=auto
# CODEX_WEBUI_ALLOWED_ROOTS=/home/me/work:/srv/repos
# CODEX_WEBUI_BASE_PATH=/codex
# CODEX_WEBUI_DATA_DIR=/absolute/path/to/codex-webui-data
# CODEX_WEBUI_CODEX_BIN=codex
# CODEX_HOME=/home/me/.codex
# CODEX_WEBUI_DEFAULT_PROFILE_ID=default
# CODEX_WEBUI_PROFILES_JSON=[{"id":"default","label":"Default","codexHome":"/home/me/.codex","dataDir":"/absolute/path/to/codex-webui-data/profiles/default"}]
# CODEX_WEBUI_MAX_UPLOAD_MB=20
# CODEX_WEBUI_MAX_ATTACHMENT_STORAGE_MB=2048
# CODEX_WEBUI_DEFAULT_AUTO_APPROVE=manual
# CODEX_WEBUI_GIT_DISCOVERY_DEPTH=1
# CODEX_WEBUI_ENABLE_SYSTEM_SHUTDOWN=false
# CODEX_WEBUI_SHUTDOWN_DELAY_SECONDS=30
# CODEX_WEBUI_SHUTDOWN_COMMAND=/usr/bin/true
